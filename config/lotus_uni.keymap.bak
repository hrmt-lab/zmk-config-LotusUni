#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // -----------------------------------------------------------------------------------------
        // Layer 0: デフォルト (QWERTY)
        // ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┐
        // │ TAB  │  Q   │  W   │  E   │  R   │  T   │  Y   │  U   │  I   │  O   │  P   │ BSPC │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │ CTRL │  A   │  S   │  D   │  F   │  G   │  H   │  J   │  K   │  L   │  ;   │ ENTR │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │ SHFT │  Z   │  X   │  C   │  V   │  B   │  N   │  M   │  ,   │  .   │  /   │  RO  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │ EAC  │ GUI  │ ALT  │ GUI  │MHEN/A│SPC/L2│DEL/L1│ SHFT │ RSE  │  ←   │  ↓   │  →   │
        // └──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┘
        // MHEN/A = 単押し:無変換(INT5) / 長押し:ALT
        // SPC/L2 = 単押し:スペース    / 長押し:Layer2
        // DEL/L1 = 単押し:DEL         / 長押し:Layer1
        default_layer {
            display-name = "LotusUni";
            bindings = <
                &kp TAB      &kp Q    &kp W    &kp E    &kp R         &kp T         &kp Y        &kp U      &kp I     &kp O     &kp P     &kp BSPC
                &kp LCTRL    &kp A    &kp S    &kp D    &kp F         &kp G         &kp H        &kp J      &kp K     &kp L     &kp SEMI  &kp ENTER
                &kp LSHFT    &kp Z    &kp X    &kp C    &kp V         &kp B         &kp N        &kp M      &kp COMMA &kp DOT   &kp FSLH  &kp INT_RO
                &kp ESC      &mo 1    &mo 3    &kp LGUI &mt LALT INT5 &lt 1 SPACE   &lt 2 DEL    &lt 4 BSPC &mo 2     &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        // -----------------------------------------------------------------------------------------
        // Layer 1: Lower (数字・funcキー)
        // ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┐
        // │  `   │  F1  │  F2  │  F3  │  F4  │  F5  │      │  7   │  8   │  9   │  0   │  @   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │  F6  │  F7  │  F8  │  F9  │ F10  │  -   │  4   │  5   │  6   │      │  =   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │  F11 │  F12 │      │      │      │      │  1   │  2   │  3   │  \   │      │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │      │      │      │      │      │      │  .   │  ,   │  0   │      │      │
        // └──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┘
        lower_layer {
            display-name = "Layer1";
            bindings = <
                &kp GRAVE &kp F1   &kp F2   &kp F3   &kp F4    &kp F5     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp LBKT
                &trans    &kp F6   &kp F7   &kp F8   &kp F9    &kp F10    &kp MINUS &kp N4    &kp N5    &kp N6    &none     &none
                &trans    &kp F11  &kp F12  &kp none &kp none  &kp none   &none     &kp N1    &kp N2    &kp N3    &kp SLASH &none
                &trans    &trans   &trans   &trans   &trans    &trans     &kp DOT   &kp COMMA &kp N0    &kp DOT   &none     &none
            >;
        };

        // -----------------------------------------------------------------------------------------
        // Layer 2: Raise (記号・BT操作)
        // ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┬──────┐
        // │  ~   │  !   │  @   │  #   │  $   │  %   │  ^   │  &   │  *   │  (   │  )   │ DEL  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │ BT0  │ BT1  │ BT2  │ BT3  │ BT4  │      │      │      │      │  _   │  +   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │BTCLR │      │      │      │      │      │      │  {   │  }   │  |   │      │
        // ├──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │      │      │      │      │(HLD) │      │      │      │      │      │      │
        // └──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┴──────┘
        raise_layer {
            display-name = "Layer2";
            bindings = <
                &kp TILDE  &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR  &kp DEL
                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans   &trans   &trans   &kp UNDER &kp PLUS
                &trans     &bt BT_CLR   &trans       &trans       &trans       &trans       &trans    &trans   &kp LBRC &kp RBRC &kp PIPE  &trans
                &trans     &trans       &trans       &trans       &trans       &trans       &trans    &trans   &trans   &trans   &trans    &trans
            >;
        };

        // Layer 3-7: 空きレイヤー（カスタマイズ用）
        layer_3 { display-name = "Layer3"; bindings = <
            &kp ESC    &kp Q    &kp W    &kp E    &kp R         &kp T        &kp Y      &kp U     &kp I     &kp O    &kp P     &kp BSPC
            &kp TAB    &kp A    &kp S    &kp D    &kp F         &kp G        &kp H      &kp J     &kp K     &kp L    &kp SEMI  &kp ENTER
            &kp LCTRL  &kp Z    &kp X    &kp C    &kp V         &kp B        &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
            &kp LSHFT  &kp LGUI &kp LALT &kp LGUI &mt LALT INT5 &lt 2 SPACE  &lt 1 DEL  &kp RSHFT &mo 2     &kp LEFT &kp DOWN  &kp RIGHT
        >; };

        layer_4 { display-name = "Layer4"; bindings = <
            &kp ESC    &kp Q    &kp W    &kp E    &kp R         &kp T        &kp Y      &kp U     &kp I     &kp O    &kp P     &kp BSPC
            &kp TAB    &kp A    &kp S    &kp D    &kp F         &kp G        &kp H      &kp J     &kp K     &kp L    &kp SEMI  &kp ENTER
            &kp LCTRL  &kp Z    &kp X    &kp C    &kp V         &kp B        &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
            &kp LSHFT  &kp LGUI &kp LALT &kp LGUI &mt LALT INT5 &lt 2 SPACE  &lt 1 DEL  &kp RSHFT &mo 2     &kp LEFT &kp DOWN  &kp RIGHT
        >; };

        layer_5 { display-name = "Layer5"; bindings = <
            &kp ESC    &kp Q    &kp W    &kp E    &kp R         &kp T        &kp Y      &kp U     &kp I     &kp O    &kp P     &kp BSPC
            &kp TAB    &kp A    &kp S    &kp D    &kp F         &kp G        &kp H      &kp J     &kp K     &kp L    &kp SEMI  &kp ENTER
            &kp LCTRL  &kp Z    &kp X    &kp C    &kp V         &kp B        &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
            &kp LSHFT  &kp LGUI &kp LALT &kp LGUI &mt LALT INT5 &lt 2 SPACE  &lt 1 DEL  &kp RSHFT &mo 2     &kp LEFT &kp DOWN  &kp RIGHT
        >; };

        layer_6 { display-name = "Layer6"; bindings = <
            &kp ESC    &kp Q    &kp W    &kp E    &kp R         &kp T        &kp Y      &kp U     &kp I     &kp O    &kp P     &kp BSPC
            &kp TAB    &kp A    &kp S    &kp D    &kp F         &kp G        &kp H      &kp J     &kp K     &kp L    &kp SEMI  &kp ENTER
            &kp LCTRL  &kp Z    &kp X    &kp C    &kp V         &kp B        &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
            &kp LSHFT  &kp LGUI &kp LALT &kp LGUI &mt LALT INT5 &lt 2 SPACE  &lt 1 DEL  &kp RSHFT &mo 2     &kp LEFT &kp DOWN  &kp RIGHT
        >; };

        layer_7 { display-name = "Settings"; bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
        >; };
    };
};
