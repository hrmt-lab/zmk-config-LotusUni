#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
	chosen{
		zmk,physical-layout = &physical_layout0;
		zmk,kscan = &kscan0;
	};

    physical_layout0: physical_layout0 {
		compatible = "zmk,physical-layout";
		display-name = "Default";
		transform = <&default_transform>;
		        
		keys  //                w   h    x    y       rot   rx    ry
            /* Row 0 — 外側ピンキー(col0)が最も低く、中指(col2/3)が最も高い列スタガー */
            = <&key_physical_attrs 100 100    0   25    0    0    0>  /* RC(0,0)  */
            , <&key_physical_attrs 100 100  100   15    0    0    0>  /* RC(0,1)  */
            , <&key_physical_attrs 100 100  200    0    0    0    0>  /* RC(0,2)  */
            , <&key_physical_attrs 100 100  300    0    0    0    0>  /* RC(0,3)  */
            , <&key_physical_attrs 100 100  400    5    0    0    0>  /* RC(0,4)  */
            , <&key_physical_attrs 100 100  500   15    0    0    0>  /* RC(0,5)  */
            , <&key_physical_attrs 100 100  625   15    0    0    0>  /* RC(0,6)  */
            , <&key_physical_attrs 100 100  725    5    0    0    0>  /* RC(0,7)  */
            , <&key_physical_attrs 100 100  825    0    0    0    0>  /* RC(0,8)  */
            , <&key_physical_attrs 100 100  925    0    0    0    0>  /* RC(0,9)  */
            , <&key_physical_attrs 100 100 1025   15    0    0    0>  /* RC(0,10) */
            , <&key_physical_attrs 100 100 1125   25    0    0    0>  /* RC(0,11) */
            /* Row 1 */
            , <&key_physical_attrs 100 100    0  125    0    0    0>  /* RC(1,0)  */
            , <&key_physical_attrs 100 100  100  115    0    0    0>  /* RC(1,1)  */
            , <&key_physical_attrs 100 100  200  100    0    0    0>  /* RC(1,2)  */
            , <&key_physical_attrs 100 100  300  100    0    0    0>  /* RC(1,3)  */
            , <&key_physical_attrs 100 100  400  105    0    0    0>  /* RC(1,4)  */
            , <&key_physical_attrs 100 100  500  115    0    0    0>  /* RC(1,5)  */
            , <&key_physical_attrs 100 100  625  115    0    0    0>  /* RC(1,6)  */
            , <&key_physical_attrs 100 100  725  105    0    0    0>  /* RC(1,7)  */
            , <&key_physical_attrs 100 100  825  100    0    0    0>  /* RC(1,8)  */
            , <&key_physical_attrs 100 100  925  100    0    0    0>  /* RC(1,9)  */
            , <&key_physical_attrs 100 100 1025  115    0    0    0>  /* RC(1,10) */
            , <&key_physical_attrs 100 100 1125  125    0    0    0>  /* RC(1,11) */
            /* Row 2 */
            , <&key_physical_attrs 100 100    0  225    0    0    0>  /* RC(2,0)  */
            , <&key_physical_attrs 100 100  100  215    0    0    0>  /* RC(2,1)  */
            , <&key_physical_attrs 100 100  200  200    0    0    0>  /* RC(2,2)  */
            , <&key_physical_attrs 100 100  300  200    0    0    0>  /* RC(2,3)  */
            , <&key_physical_attrs 100 100  400  205    0    0    0>  /* RC(2,4)  */
            , <&key_physical_attrs 100 100  500  215    0    0    0>  /* RC(2,5)  */
            , <&key_physical_attrs 100 100  625  215    0    0    0>  /* RC(2,6)  */
            , <&key_physical_attrs 100 100  725  205    0    0    0>  /* RC(2,7)  */
            , <&key_physical_attrs 100 100  825  200    0    0    0>  /* RC(2,8)  */
            , <&key_physical_attrs 100 100  925  200    0    0    0>  /* RC(2,9)  */
            , <&key_physical_attrs 100 100 1025  215    0    0    0>  /* RC(2,10) */
            , <&key_physical_attrs 100 100 1125  225    0    0    0>  /* RC(2,11) */
            /* Row 3 */
            , <&key_physical_attrs 100 100    0  325    0    0    0>  /* RC(3,0)  */
            , <&key_physical_attrs 100 100  100  315    0    0    0>  /* RC(3,1)  */
            , <&key_physical_attrs 100 100  200  300    0    0    0>  /* RC(3,2)  */
            , <&key_physical_attrs 100 100  300  300    0    0    0>  /* RC(3,3)  */
            , <&key_physical_attrs 100 100  400  305    0    0    0>  /* RC(3,4)  */
            , <&key_physical_attrs 100 100  500  315    0    0    0>  /* RC(3,5)  */
            , <&key_physical_attrs 100 100  625  315    0    0    0>  /* RC(3,6)  */
            , <&key_physical_attrs 100 100  725  305    0    0    0>  /* RC(3,7)  */
            , <&key_physical_attrs 100 100  825  300    0    0    0>  /* RC(3,8)  */
            , <&key_physical_attrs 100 100  925  300    0    0    0>  /* RC(3,9)  */
            , <&key_physical_attrs 100 100 1025  315    0    0    0>  /* RC(3,10) */
            , <&key_physical_attrs 100 100 1125  325    0    0    0>  /* RC(3,11) */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11)
        >;
    };

    kscan0: kscan_0 {
        wakeup-source;
        diode-direction = "col2row";
    };
};
